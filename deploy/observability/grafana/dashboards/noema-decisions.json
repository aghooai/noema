      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "type": "timeseries",
      "title": "L2 decision cache hit ratio",
      "description": "L2 hits / (hits + misses); misses include bypass and error.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(aghoo_cache_hits_total{layer=\"l2\"}[5m])) / (sum(rate(aghoo_cache_hits_total{layer=\"l2\"}[5m])) + sum(rate(aghoo_cache_misses_total{layer=\"l2\"}[5m])))",
          "legendFormat": "hit ratio",
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "type": "timeseries",
      "title": "Cache misses by reason",
