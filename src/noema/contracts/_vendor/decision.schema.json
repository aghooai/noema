{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aghoo.example/schemas/decision/v0.2",
  "title": "Noema decision contracts (v0.2)",
  "description": "Request and result schemas for the native POST /v1/decisions. Mirrors types.ts. Semantic invariants (probabilities sum to 1, choice = argmax with declared-order ties, score = expected index, confidence formulas, quorum and timing consistency, calibration acceptance, request/result pairing) are checked by check_examples.py.",
  "$ref": "#/$defs/DecisionResult",
  "$defs": {
    "Name": {
      "type": "string",
      "pattern": "^(?!q[0-9]+$)[a-z][a-z0-9_]{0,63}$",
      "description": "Request-side question name. q followed by digits is reserved: the OpenAI facade names unnamed questions q0, q1, \u2026 internally."
    },
    "AnswerName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Response-side answer name: a request Name, or a facade-generated q<digits> name (stored facade decisions)."
    },
    "Prob": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "Instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "PredicateQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "instructions"
      ],
      "properties": {
        "type": {
          "enum": [
            "predicate",
            "noul"
          ],
          "description": "OpenAI (predicate) and Jev (noul) names are synonyms."
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "instructions": {
          "$ref": "#/$defs/Instructions"
        },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "true": {
              "type": "string",
              "maxLength": 10000
            },
            "false": {
              "type": "string",
              "maxLength": 10000
            }
          }
        }
      }
    },
    "ChoiceQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "instructions",
        "choices"
      ],
      "properties": {
        "type": {
          "const": "choice"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "instructions": {
          "$ref": "#/$defs/Instructions"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 255,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "$ref": "#/$defs/Description"
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Optional group label for hierarchical elicitation (08 \u00a73.4). All choices carry one or none; groups partition the options."
              }
            }
          },
          "description": "2-255 distinct values. When the count exceeds a member's template max_choices, the answer uses the hierarchical method: stage 1 over groups, stage 2 inside the top groups."
        }
      }
    },
    "ScoreQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "instructions",
        "levels"
      ],
      "properties": {
        "type": {
          "const": "score"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "instructions": {
          "$ref": "#/$defs/Instructions"
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "$ref": "#/$defs/Description"
              }
            }
          }
        }
      }
    },
    "Question": {
      "oneOf": [
        {
          "$ref": "#/$defs/PredicateQuestion"
        },
        {
          "$ref": "#/$defs/ChoiceQuestion"
        },
        {
          "$ref": "#/$defs/ScoreQuestion"
        }
      ]
    },
    "InputPart": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "input_text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "image_url"
          ],
          "properties": {
            "type": {
              "const": "input_image"
            },
            "image_url": {
              "type": "string",
              "pattern": "^data:image/(png|jpeg|webp|gif|heic|heif);base64,",
              "description": "Base64 data URL. The server decodes it and answers 413 image_too_large above 3,750,000 decoded bytes or 8,000 px per side; the JSON body cap (413 request_too_large) bounds the string. Remote http(s) URLs are never fetched."
            },
            "detail": {
              "enum": [
                "low",
                "high",
                "auto",
                "original"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "file_id"
          ],
          "properties": {
            "type": {
              "const": "input_image"
            },
            "file_id": {
              "type": "string",
              "pattern": "^file_"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "file_id"
          ],
          "properties": {
            "type": {
              "const": "input_file"
            },
            "file_id": {
              "type": "string",
              "pattern": "^file_"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "json"
          ],
          "properties": {
            "type": {
              "const": "input_json"
            },
            "json": true
          }
        }
      ]
    },
    "DecisionCreateParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "questions"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(@[0-9]+)?$",
          "description": "Decision profile id, optionally version-pinned (router-default@1). Optional: the default is the tenant's defaults.decision_profile (lightweight-model-decide unless the tenant configures another, D6). Must be the default or in the tenant's request_overrides allowlist (403 profile_not_allowed)."
        },
        "input": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "description": "At most 64 media parts (input_image and input_file, inline or uploaded, over all messages) per request; more is 400 schema_violation (param input, details.max_media_parts 64), checked before any file lookup.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "content"
                ],
                "properties": {
                  "role": {
                    "const": "user"
                  },
                  "content": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/InputPart"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": true,
              "description": "JEV-style JSON state"
            }
          ]
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Question"
          }
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "min_quorum": {
          "type": "integer",
          "minimum": 1
        },
        "escalation": {
          "enum": [
            "profile_default",
            "off"
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^ses_"
        },
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "members",
              "member_distributions",
              "stages"
            ]
          }
        },
        "safety_identifier": {
          "type": "string",
          "maxLength": 128
        },
        "output_format": {
          "enum": [
            "native",
            "jev"
          ],
          "default": "native"
        }
      }
    },
    "HoldoutMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "label_source",
        "labelers",
        "consensus_rate",
        "consensus_rate_by_class",
        "n",
        "n_by_class",
        "ece",
        "brier",
        "nll",
        "nll_uncalibrated",
        "flagged_classes",
        "scope",
        "family_overlap",
        "evaluated_at"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "label_source": {
          "const": "llm_consensus",
          "description": "D4: only LLM-consensus labels exist."
        },
        "labelers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "consensus_rate": {
          "$ref": "#/$defs/Prob",
          "description": "Share of all sampled items kept (both labelers agreed)."
        },
        "consensus_rate_by_class": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "$ref": "#/$defs/Prob"
          },
          "description": "Consensus rate per class (declared option / level). Acceptance: every class >= 0.6."
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "ece": {
          "$ref": "#/$defs/Prob"
        },
        "brier": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "nll": {
          "type": "number",
          "minimum": 0
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "n_by_class": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Holdout labels per class; values sum to n."
        },
        "nll_uncalibrated": {
          "type": "number",
          "minimum": 0,
          "description": "NLL of the same holdout before calibration; acceptance: nll <= nll_uncalibrated."
        },
        "flagged_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Classes with fewer than 30 holdout labels: classwise calibration is not evidenced; do not auto-act on them."
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "retained_share",
            "slices"
          ],
          "description": "What the holdout evidences.",
          "properties": {
            "target": {
              "const": "llm_consensus_agreement",
              "description": "The calibrated quantity is agreement with the labelers' consensus, not correctness against outcomes."
            },
            "retained_share": {
              "$ref": "#/$defs/Prob",
              "description": "Share of the uniform-random traffic sample whose labels were kept (consensus). The rest is outside the evidence."
            },
            "slices": {
              "type": "array",
              "minItems": 1,
              "description": "Deployment slices (language, input view, responding subset) with holdout labels.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "n"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "family_overlap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_member_lift",
            "threshold"
          ],
          "description": "Labeler-family check (06 \u00a72.2): largest member-labeler agreement lift over a random-label baseline; calibrated requires max_member_lift <= threshold.",
          "properties": {
            "max_member_lift": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "description": "Evidence behind status calibrated. Calibration is relative to LLM-consensus labels (D4) on the items where the labelers agreed; `scope` says which population that is."
    },
    "CalibrationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "question_signature",
        "input_view_signature",
        "choice_method"
      ],
      "description": "What the calibrator was fitted for. An answer is `calibrated` only if this matches the stage that produced it, the question, the input views, the answering member subset and the choice method.",
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "question_signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "sha256 of this question's canonical definition."
        },
        "input_view_signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "choice_method": {
          "enum": [
            "flat",
            "hierarchical"
          ]
        }
      }
    },
    "Calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "calibrated",
            "provider_reported",
            "uncalibrated"
          ]
        },
        "source": {
          "enum": [
            "logprob",
            "verbalized",
            "mixed"
          ]
        },
        "method": {
          "enum": [
            "temperature",
            "platt",
            "isotonic",
            "dirichlet"
          ]
        },
        "calibrator_id": {
          "type": "string"
        },
        "member_subset": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "holdout": {
          "$ref": "#/$defs/HoldoutMetrics"
        },
        "binding": {
          "$ref": "#/$defs/CalibrationBinding"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "calibrated"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "method",
          "calibrator_id",
          "member_subset",
          "binding",
          "holdout"
        ],
        "properties": {
          "status": true,
          "method": true,
          "calibrator_id": true,
          "member_subset": true,
          "holdout": true,
          "binding": true
        }
      }
    },
    "HeuristicConfidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "method",
        "band",
        "margin",
        "normalized_entropy",
        "agreement",
        "member_divergence"
      ],
      "properties": {
        "kind": {
          "const": "heuristic"
        },
        "value": {
          "$ref": "#/$defs/Prob"
        },
        "method": {
          "enum": [
            "normalized_max",
            "ordinal_dispersion",
            "agreement",
            "provider"
          ]
        },
        "band": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "margin": {
          "$ref": "#/$defs/Prob"
        },
        "normalized_entropy": {
          "$ref": "#/$defs/Prob"
        },
        "agreement": {
          "$ref": "#/$defs/Prob"
        },
        "member_divergence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "reasoning_tokens",
        "cost_usd",
        "cost_estimated",
        "tokens_estimated"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Input tokens written to the provider prompt cache (billed at the write rate)."
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "cost_estimated": {
          "type": "boolean"
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of output_tokens spent on reasoning (billed as output)."
        },
        "tokens_estimated": {
          "type": "boolean",
          "description": "True when the provider returned no usage (a cancelled call) and the counts are Noema's estimate. Missing provider usage is not zero usage."
        }
      },
      "description": "Disjoint token categories. input_tokens is the total input including cache reads and writes; cached_input_tokens (reads) and cache_write_input_tokens are parts of it. output_tokens includes reasoning_tokens. Cost is computed from the disjoint categories: uncached input, cache reads, cache writes, output."
    },
    "QuorumInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "responded",
        "refused",
        "total"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 1
        },
        "responded": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "MemberVote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "provider",
        "model",
        "elicitation",
        "input_view",
        "status",
        "weight",
        "latency_ms"
      ],
      "properties": {
        "member_id": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "bedrock-converse",
            "bedrock-mantle-chat"
          ]
        },
        "model": {
          "type": "string"
        },
        "model_revision": {
          "type": "string",
          "description": "Provider-reported model revision, when the API returns one (none of the retained probe responses did). Absent otherwise: profile versions pin model ids, not provider revisions."
        },
        "region": {
          "type": "string"
        },
        "elicitation": {
          "enum": [
            "token_logprobs",
            "verbalized",
            "sampling",
            "native_decision"
          ]
        },
        "input_view": {
          "enum": [
            "native",
            "thumbnail",
            "ocr_text",
            "derived_text",
            "keyframes_transcript",
            "metadata_only",
            "skipped"
          ],
          "description": "What this member saw of the media. native: the original media block. keyframes_transcript: video as keyframe images plus transcript. See 02 \u00a75.3 for which views are adequate per modality."
        },
        "status": {
          "enum": [
            "ok",
            "refused",
            "timeout",
            "error",
            "late",
            "skipped"
          ]
        },
        "distribution": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Prob"
          }
        },
        "calibrated_distribution": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Prob"
          }
        },
        "calibrator_id": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "skip_reason": {
          "enum": [
            "input_view",
            "too_many_choices"
          ],
          "description": "Why a skipped member did not run: it cannot see the media (input_view), or it cannot run the flat or hierarchical method for this question (too_many_choices)."
        },
        "censored_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Declared options this member could not measure (absent from the returned top logprobs). They carry no probability here; their share is in unresolved_mass."
        },
        "unresolved_mass": {
          "$ref": "#/$defs/Prob",
          "description": "This member's probability mass not attributed to any option: the unlisted logprob tail when an option was censored, or the groups the hierarchical method did not expand. distribution sums to 1 - unresolved_mass."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "distribution"
            ],
            "properties": {
              "distribution": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "input_view": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "skipped"
              },
              "skip_reason": {
                "const": "input_view"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "skip_reason"
            ],
            "properties": {
              "skip_reason": true
            }
          }
        }
      ]
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "probability",
        "raw_score",
        "votes"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "probability": {
          "$ref": "#/$defs/Prob"
        },
        "raw_score": {
          "type": "number"
        },
        "votes": {
          "type": "integer",
          "minimum": 0
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ScoredBase": {
      "type": "object",
      "required": [
        "type",
        "name",
        "calibration",
        "confidence",
        "quorum",
        "candidates"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/AnswerName"
        },
        "calibration": {
          "$ref": "#/$defs/Calibration"
        },
        "confidence": {
          "$ref": "#/$defs/HeuristicConfidence"
        },
        "quorum": {
          "$ref": "#/$defs/QuorumInfo"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberVote"
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/Candidate"
          }
        },
        "unresolved_mass": {
          "$ref": "#/$defs/Prob",
          "description": "Pooled mass not attributed to any candidate (censored logprob tails, unexpanded groups). Never spread over options. candidates sum to 1 - unresolved_mass; confidence counts it as one extra bucket."
        }
      }
    },
    "PredicateAnswer": {
      "allOf": [
        {
          "$ref": "#/$defs/ScoredBase"
        }
      ],
      "required": [
        "type",
        "probability"
      ],
      "properties": {
        "type": {
          "enum": [
            "predicate",
            "noul"
          ]
        },
        "probability": {
          "$ref": "#/$defs/Prob"
        },
        "name": true,
        "calibration": true,
        "confidence": true,
        "quorum": true,
        "members": true,
        "candidates": {
          "maxItems": 2,
          "items": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "ChoiceAnswer": {
      "allOf": [
        {
          "$ref": "#/$defs/ScoredBase"
        }
      ],
      "required": [
        "type",
        "choice"
      ],
      "properties": {
        "type": {
          "const": "choice"
        },
        "choice": {
          "type": "string"
        },
        "name": true,
        "calibration": true,
        "confidence": true,
        "quorum": true,
        "members": true,
        "candidates": {
          "items": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        "choice_method": {
          "enum": [
            "flat",
            "hierarchical"
          ],
          "default": "flat",
          "description": "flat: one call per member over all options. hierarchical: stage 1 over groups, stage 2 inside the top groups (08 \u00a73.4). Calibrators bind to the method."
        },
        "groups": {
          "type": "array",
          "minItems": 2,
          "description": "Present iff choice_method is hierarchical: the partition of the declared options and the pooled stage-1 distribution over it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "options",
              "probability",
              "expanded"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^g[0-9]+$"
              },
              "label": {
                "type": "string",
                "description": "Request-supplied group name, or \"options a-b\" (1-based declared positions) for a server split."
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "probability": {
                "$ref": "#/$defs/Prob",
                "description": "Pooled stage-1 mass of the group."
              },
              "expanded": {
                "type": "boolean",
                "description": "True when stage 2 ran inside the group. Options of unexpanded groups are not emitted as candidates."
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "ScoreAnswer": {
      "allOf": [
        {
          "$ref": "#/$defs/ScoredBase"
        }
      ],
      "required": [
        "type",
        "score",
        "level"
      ],
      "properties": {
        "type": {
          "const": "score"
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "level": {
          "type": "string"
        },
        "name": true,
        "calibration": true,
        "confidence": true,
        "quorum": true,
        "members": true,
        "candidates": {
          "items": {
            "required": [
              "index"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "index": true
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "RefusalAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "const": "refusal"
        },
        "name": {
          "$ref": "#/$defs/AnswerName"
        },
        "quorum": {
          "$ref": "#/$defs/QuorumInfo"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberVote"
          }
        }
      }
    },
    "UnavailableAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "unavailable"
        },
        "name": {
          "$ref": "#/$defs/AnswerName"
        },
        "reason": {
          "enum": [
            "deadline_exceeded",
            "no_quorum",
            "all_members_failed",
            "no_capable_member"
          ]
        },
        "quorum": {
          "$ref": "#/$defs/QuorumInfo"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberVote"
          }
        }
      }
    },
    "Answer": {
      "oneOf": [
        {
          "$ref": "#/$defs/PredicateAnswer"
        },
        {
          "$ref": "#/$defs/ChoiceAnswer"
        },
        {
          "$ref": "#/$defs/ScoreAnswer"
        },
        {
          "$ref": "#/$defs/RefusalAnswer"
        },
        {
          "$ref": "#/$defs/UnavailableAnswer"
        }
      ]
    },
    "EscalationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "triggered_by",
        "questions",
        "usage"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "triggered_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "confidence_below",
              "margin_below",
              "refused",
              "unavailable"
            ]
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnswerName"
          }
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "input_view_signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "sha256 over this stage's per-member input views (members are numbered m1..mN within the stage). Calibrator bindings of answers from this stage use it."
        },
        "prompt_templates": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9-]+@[0-9]+$"
          },
          "description": "member_id -> template version for this stage's members."
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "profile_id",
        "profile_version",
        "question_signature",
        "input_digest",
        "input_view_signature",
        "option_order_seed",
        "prompt_templates",
        "aggregation",
        "deadline_ms",
        "quorum",
        "cache",
        "stages",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "question_signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^hmac-sha256:[0-9a-f]{64}$"
        },
        "input_view_signature": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "option_order_seed": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_templates": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9-]+@[0-9]+$"
          }
        },
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "linear_pool",
                "log_pool",
                "stacked"
              ]
            },
            "weights_version": {
              "type": "string"
            }
          }
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 0
        },
        "quorum": {
          "$ref": "#/$defs/QuorumInfo"
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hit"
          ],
          "properties": {
            "hit": {
              "type": "boolean"
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EscalationStage"
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "DecisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object",
        "created_at",
        "status",
        "answers",
        "provenance",
        "usage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dec_"
        },
        "object": {
          "const": "decision"
        },
        "created_at": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "quorum",
            "partial"
          ]
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Answer"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      }
    },
    "JevAnswer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "noul"
          ],
          "properties": {
            "type": {
              "const": "noul"
            },
            "noul": {
              "$ref": "#/$defs/Prob"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "choice",
            "probabilities",
            "confidence"
          ],
          "properties": {
            "type": {
              "const": "choice"
            },
            "choice": {
              "type": "string"
            },
            "probabilities": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "$ref": "#/$defs/Prob"
              }
            },
            "confidence": {
              "$ref": "#/$defs/Prob"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "score",
            "legend",
            "probabilities",
            "confidence"
          ],
          "properties": {
            "type": {
              "const": "score"
            },
            "score": {
              "type": "number",
              "minimum": 0
            },
            "legend": {
              "type": "object",
              "minProperties": 2,
              "propertyNames": {
                "pattern": "^[0-9]+$"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "probabilities": {
              "type": "object",
              "minProperties": 2,
              "propertyNames": {
                "pattern": "^[0-9]+$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Prob"
              }
            },
            "confidence": {
              "$ref": "#/$defs/Prob"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "refusal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "deadline_exceeded",
                "no_quorum",
                "all_members_failed",
                "no_capable_member"
              ]
            }
          }
        }
      ]
    },
    "JevDecisionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "answers",
        "usage",
        "decision_id"
      ],
      "description": "output_format: jev. Mirrors TypeSafe Jev's answer shapes; produced by Bedrock profiles (e.g. lightweight-model-decide = gpt-6-luna).",
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^aghoo/[a-z0-9][a-z0-9._-]*@[0-9]+$"
        },
        "answers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/Name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JevAnswer"
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "decision_id": {
          "type": "string",
          "pattern": "^dec_"
        }
      }
    }
  }
}
